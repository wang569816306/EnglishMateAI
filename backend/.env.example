# OpenAI API 配置
OPENAI_API_KEY='your-api-key-here'
OPENAI_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
OPENAI_MODEL='qwen-plus'

# 服务配置（可选）
SERVICE_NAME='FastAPI + LangChain AI 服务'
SERVICE_VERSION='1.0.0'
TEMPERATURE=0.7

# CORS 配置（多个域名用逗号分隔，* 表示允许所有）
CORS_ORIGINS='*'

# 请求体大小限制（字节，默认 1MB = 1048576 字节）
# 常用值：1MB=1048576, 5MB=5242880, 10MB=10485760
MAX_REQUEST_SIZE=1048576

# API Key 认证配置
# 是否启用 API Key 认证（true/false）
API_KEY_ENABLED=false
# 有效的 API Keys（多个用逗号分隔）
API_KEYS=test-key-12345,admin-key-67890
